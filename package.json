{
  "name": "backend-service-template",
  "version": "1.0.0",
  "description": "A clean, simple Node.js/TypeScript backend service template with TypeORM, Express, and OpenAPI documentation",
  "main": "src/app.ts",
  "repository": "https://github.com/your-username/backend-service-template",
  "author": "Your Name",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon --exec node --loader ts-node/esm src/index.ts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint --fix src/**/*.ts",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "format:write": "prettier --write \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "test": "jest --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "migration:generate": "npx typeorm-ts-node-esm migration:generate -d src/config/dbConnection.ts src/migrations/$npm_config_name",
    "migration:run": "npx typeorm-ts-node-esm migration:run -d src/config/dbConnection.ts",
    "seed": "node --loader ts-node/esm src/utils/seedAll.ts",
    "seed:force": "node --loader ts-node/esm -e \"import('./src/utils/seedAnalytics.js').then(m => m.seedAnalytics().then(() => process.exit(0)).catch(e => {console.error(e); process.exit(1)}))\"",
    "seed:vehicles": "node --loader ts-node/esm src/utils/seedVehicles.js"
  },
  "dependencies": {
    "@intelika/swagger-theme": "^1.0.4",
    "@scalar/express-api-reference": "^0.4.192",
    "@sinclair/typebox": "^0.34.33",
    "@wesleytodd/openapi": "^1.1.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "envalid": "^8.0.0",
    "express": "^4.21.1",
    "morgan": "^1.10.0",
    "morgan-body": "^2.6.9",
    "pg": "^8.13.3",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.24",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@tsconfig/node20": "^20.1.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.1",
    "@types/supertest": "^2.0.16",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "eslint": "^9.21.0",
    "globals": "^15.13.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.4.2",
    "supertest": "^6.3.4",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.25.0"
  }
}
