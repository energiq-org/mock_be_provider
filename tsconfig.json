{
  "extends": "@tsconfig/node20/tsconfig.json"
,
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "dist",
    "noImplicitAny": false,
    "esModuleInterop": true,
    "allowJs": true,
  },
  "include": [
    "src/**/*.*",
    "eslint.config.mjs"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.js",
    "**/*.test.ts"
  ]
}