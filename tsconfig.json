{
  "extends": "@tsconfig/node20/tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@src/*": ["src/*"]
    },
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "outDir": "dist",
    "noImplicitAny": false,
    "esModuleInterop": true,
    "allowJs": true,
    //"allowImportingTsExtensions": true,
    "noEmit": false
  },
  "include": [
    "src/**/*.*"
  ],
  "exclude": [
    "./eslint.config.mjs",
    "node_modules",
    "dist",
    "**/*.js",
    "**/*.test.ts"
  ],
  "ts-node": {
    "experimentalSpecifierResolution": "node",
    "transpileOnly": true,
    "esm": true
  }
}
